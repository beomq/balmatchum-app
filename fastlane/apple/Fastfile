require_relative 'asc_preflight'
require_relative '../../tool/apple/build_number'
require_relative '../../tool/apple/verify_package'
require_relative '../../tool/apple/delivery_target'
require_relative '../../tool/apple/app_config'

default_platform(:ios)

platform :ios do
  desc 'Build, sign, preflight, and upload only the explicit Dev or Prod app'
  lane :upload_only do |options|
    target = options[:target]
    mode = options[:mode]
    AppleDeliveryTarget.verify!(target: target, mode: mode, ref: ENV.fetch('GITHUB_REF'))
    UI.user_error!('mode must be verify or upload') unless %w[verify upload].include?(mode)
    UI.user_error!('target must be dev or prod') unless %w[dev prod].include?(target)
    admob_app_id = ENV.fetch('ADMOB_IOS_APP_ID', '')
    unless admob_app_id.match?(/\Aca-app-pub-\d{16}~\d{10}\z/) && !admob_app_id.start_with?('ca-app-pub-3940256099942544~')
      UI.user_error!('A real environment-specific ADMOB_IOS_APP_ID is required for archive builds')
    end
    config = target == 'dev' ? 'Dev' : 'Prod'
    scheme = target == 'dev' ? 'dev' : 'Runner'
    configuration = target == 'dev' ? 'Release-dev' : 'Release'
    bundle = target == 'dev' ? 'com.beomq.balmatchum.dev' : 'com.beomq.balmatchum'
    app_id = target == 'dev' ? '6816329763' : '6816329577'
    # Per-target profiles: Swift package resource bundles must not receive one.
    profiles = if target == 'dev'
      { 'Runner' => 'Balmatchum Dev AppStore', 'BalmatchumWatch' => 'Balmatchum Dev Watch AppStore' }
    else
      { 'Runner' => 'Balmatchum AppStore', 'BalmatchumWatch' => 'Balmatchum Watch AppStore' }
    end
    root = File.expand_path('../..', __dir__)
    output = File.expand_path(ENV.fetch('APPLE_OUTPUT_DIR'))
    app_config_path = File.join(output, 'app-config.json')
    if target == 'prod'
      sh('bash', File.join(root, 'tool/release_app_config.sh'), 'ios', app_config_path)
      app_config = AppleAppConfig.load(app_config_path)
      app_settings = AppleAppConfig.build_settings(app_config)
    end
    key_path = ENV.fetch('ASC_KEY_PATH')
    key_id = ENV.fetch('ASC_KEY_ID')
    issuer = ENV.fetch('ASC_ISSUER_ID')
    UI.user_error!('Unapproved ASC key metadata') unless key_id == '92H5A2KQDS' && issuer == '2da40195-da6d-460f-98b2-11ce9390c5f5'
    private_key = OpenSSL::PKey.read(File.read(key_path))
    fetcher = lambda { |path| ApplePreflight.get_pages(path, key_id: key_id, issuer: issuer, private_key: private_key) }
    ApplePreflight.verify!(bundle: bundle, app_id: app_id, fetcher: fetcher)
    builds_path = "/v1/builds?filter%5Bapp%5D=#{app_id}&limit=200"
    history = fetcher.call(builds_path).map { |build| build.fetch('attributes').fetch('version') }
    number = AppleBuildNumber.next_after(history)

    # Caller supplies a restricted temporary keychain and cleans it in always/finally.
    match(type: 'appstore', readonly: true, git_url: 'git@github.com:beomq/balmatchum-signing.git',
      git_branch: 'main', team_id: 'Q4E6NKD9VN', app_identifier: [bundle, "#{bundle}.watchkitapp"],
      keychain_name: ENV.fetch('MATCH_KEYCHAIN_NAME'), keychain_password: ENV.fetch('MATCH_KEYCHAIN_PASSWORD'))
    identities = ApplePackage.command('security', 'find-identity', '-v', '-p', 'codesigning', ENV.fetch('MATCH_KEYCHAIN_NAME'))
    UI.user_error!('Expected match identity missing') unless identities.include?('854F9BAF7FF80F154488723861262200C0F9960D')
    UI.message('APPLE_MATCH_READONLY_IMPORT_VERIFIED certificate=848N8ZSD6A')

    Dir.chdir(root) do
      sh('fvm', 'flutter', 'pub', 'get', '--enforce-lockfile')
      args = ['fvm', 'flutter', 'build', 'ios', '--release', '--config-only', '--no-codesign', '--no-pub', "--build-number=#{number}"]
      args += ['--flavor', 'dev'] if target == 'dev'
      args << "--dart-define-from-file=#{app_config_path}" if app_config
      sh(*args)
      AppleAppConfig.verify_dart_defines!(File.join(root, 'ios/Flutter/Generated.xcconfig'), app_config) if app_config
      profiles.each do |name, profile|
        update_code_signing_settings(path: File.join(root, 'ios/Runner.xcodeproj'),
          use_automatic_signing: false, team_id: 'Q4E6NKD9VN', targets: [name],
          build_configurations: [configuration], code_sign_identity: 'Apple Distribution',
          profile_name: profile)
      end
      archive = File.join(output, "#{config}.xcarchive")
      export = File.join(output, 'export')
      sh('xcodebuild', '-workspace', 'ios/Runner.xcworkspace', '-scheme', scheme,
        '-configuration', configuration, '-destination', 'generic/platform=iOS',
        '-archivePath', archive, '-xcconfig', "ios/Signing/#{config}Archive.xcconfig",
        "ADMOB_IOS_APP_ID=#{admob_app_id}", *(app_settings || {}).map { |key, value| "#{key}=#{value}" }, 'archive')
      sh('xcodebuild', '-exportArchive', '-archivePath', archive, '-exportPath', export,
        '-exportOptionsPlist', "ios/Signing/ExportOptions-#{config}.plist")
      ApplePackage.verify!(archive: archive, ipa: File.join(export, 'balmatchum_app.ipa'), bundle: bundle, number: number)
      if app_settings
        info = ApplePackage.plist(File.join(archive, 'Products/Applications/Runner.app/Info.plist'))
        AppleAppConfig.verify_url_schemes!(info, app_settings)
      end
      ApplePreflight.verify!(bundle: bundle, app_id: app_id, fetcher: fetcher)
      next if mode == 'verify'
      current = fetcher.call(builds_path).map { |build| build.fetch('attributes').fetch('version') }
      UI.user_error!('ASC build history changed; rebuild required') unless current.all? { |v| AppleBuildNumber.ordinal(v) < AppleBuildNumber.ordinal(number) }
      api = app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: key_path,
        duration: 120, in_house: false, set_spaceship_token: false)
      upload_to_testflight(api_key: api, app_identifier: bundle, apple_id: app_id,
        ipa: File.join(export, 'balmatchum_app.ipa'), skip_submission: true,
        skip_waiting_for_build_processing: true, distribute_external: false,
        notify_external_testers: false, submit_beta_review: false)
    end
  end
end
