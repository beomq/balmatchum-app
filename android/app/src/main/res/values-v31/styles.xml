<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/branding_cream</item>
        <item name="android:windowSplashScreenBackground">@color/branding_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/branding_cream</item>
        <item name="android:navigationBarColor">@color/branding_cream</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
